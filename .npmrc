# npm install 結尾不顯示弱點報告與贊助訊息。
# 練習專案不升級套件：npm audit fix --force 會改動 package.json 與 package-lock.json，學員不要執行。
# 維護這個模板的人，每一梯開課前自己執行一次 npm audit，必要時更新套件與鎖定檔。
audit=false
fund=false
# Node.js 要 24.14.1 以上的 24 版或 26 版（package.json 的 engines）。版本不對時直接停止安裝：
# 更舊的 Node 24 附的 npm 會改寫 package-lock.json，npm install 之後 git status 就不乾淨。
engine-strict=true
