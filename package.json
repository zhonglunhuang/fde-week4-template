{
  "name": "practice-app",
  "version": "0.1.0",
  "private": true,
  "description": "練習專案骨架：Harness 協作框架，加上 Node.js、React 與 PostgreSQL 的骨架，以及第四週的 Staging 操作（部署、備份、只讀查詢）",
  "type": "module",
  "engines": {
    "node": "^24.14.1 || ^26.0.0"
  },
  "scripts": {
    "dev:api": "tsx backend/src/server.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "db:migrate": "tsx backend/db/migrate.ts",
    "db:seed": "tsx backend/db/seed.ts",
    "db:reset": "tsx backend/db/reset.ts",
    "db:query": "tsx backend/db/query.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p backend/tsconfig.build.json && vite build --config frontend/vite.config.ts",
    "staging:build": "node backend/scripts/staging-build.mjs",
    "staging:start": "node backend/scripts/staging-start.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
