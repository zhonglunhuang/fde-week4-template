# 資料庫連線位置：本機 Container 裡的練習資料庫（帳號密碼是 docker-compose.yml 的本機練習值）
DATABASE_URL=postgres://127.0.0.1:5432/app?user=app&password=local_only
# 後端使用的埠
API_PORT=4000
# 前端呼叫後端的位址（改了 API_PORT，這裡要一起改）
API_BASE_URL=http://localhost:4000
# 登入用的簽章金鑰：每個人自己產生，不可以提交，也不要貼給任何人
SESSION_SECRET=
# 種子資料的測試帳號共用的密碼（npm run db:seed 用）：自己取，至少 10 個字，不要用平常用的密碼。
# 只寫在自己的 .env，不寫進任何文件；Staging 的由技術導師設定。
SEED_USER_PASSWORD=
